
{{> head }}
<body class="bg-gray-50">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">Student Management</h1>

    <form method="POST" action="/students" class="mb-8 space-y-3">
      <input name="FirstName" placeholder="First Name" required class="border p-2">
      <input name="LastName" placeholder="Last Name" required class="border p-2">
      <input name="MiddleName" placeholder="Middle Name" class="border p-2">
      <input name="Program" placeholder="Program" required class="border p-2">
      <input name="YearLevel" placeholder="Year Level" required class="border p-2">
      <input name="Section" placeholder="Section" required class="border p-2">
      <button type="submit" class="bg-blue-600 text-white px-4 py-2">Add Student</button>
    </form>

    <h2 class="text-xl font-bold mb-4">Students List</h2>

    {{#each students}}
      <div class="border p-4 mb-3 bg-white">
        <p>{{FirstName}} {{LastName}}</p>
        <p>{{Program}} - {{YearLevel}} - {{Section}}</p>
        <a href="/students/{{id}}" class="text-blue-600">Edit</a>

        <form method="POST" action="/students/{{id}}/delete">
          <button type="submit" class="text-red-600">Delete</button>
        </form>
      </div>
    {{/each}}
  </div>
  {{> footer }}
</body>
</html>
