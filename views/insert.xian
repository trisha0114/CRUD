{{> head }}
<body class="bg-gray-50 min-h-screen">
  <div class="container mx-auto px-4 py-8 max-w-3xl">

    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-gray-800">
        Add New Book
      </h1>

      <a href="/books"
         class="text-blue-600 hover:underline">
        ← Back to Books
      </a>
    </div>

    <div class="bg-white shadow-md rounded-lg p-6">
      <form method="POST" action="/books" class="space-y-5">

        <div>
          <label class="block font-semibold mb-1" for="BookTitle">
            Book Title
          </label>
          <input
            type="text"
            id="BookTitle"
            name="BookTitle"
            placeholder="Enter book title"
            required
            class="w-full border rounded-lg p-3"
          >
        </div>

        <div>
          <label class="block font-semibold mb-1" for="Author">
            Author
          </label>
          <input
            type="text"
            id="Author"
            name="Author"
            placeholder="Enter author name"
            required
            class="w-full border rounded-lg p-3"
          >
        </div>

        <div>
          <label class="block font-semibold mb-1" for="Genre">
            Genre
          </label>
          <input
            type="text"
            id="Genre"
            name="Genre"
            placeholder="Enter book genre"
            required
            class="w-full border rounded-lg p-3"
          >
        </div>

        <div>
          <label class="block font-semibold mb-1" for="Quantity">
            Quantity
          </label>
          <input
            type="number"
            id="Quantity"
            name="Quantity"
            min="0"
            placeholder="Enter quantity"
            required
            class="w-full border rounded-lg p-3"
          >
        </div>

        <div class="flex gap-3">
          <button
            type="submit"
            class="bg-green-600 hover:bg-green-700 text-white font-semibold px-5 py-3 rounded-lg"
          >
            Save Book
          </button>

          <a
            href="/books"
            class="bg-gray-200 hover:bg-gray-300 px-5 py-3 rounded-lg"
          >
            Cancel
          </a>
        </div>

      </form>
    </div>
  </div>
{{> footer }}
</body>
</html>