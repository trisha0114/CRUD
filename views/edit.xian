{{> head }}
<body class="bg-gray-50 min-h-screen">
  <div class="container mx-auto px-4 py-8 max-w-3xl">

    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-gray-800">
        Edit Book
      </h1>

      <a href="/books" class="text-blue-600 hover:underline">
        ← Back to Books
      </a>
    </div>

    <div class="bg-white shadow-md rounded-lg p-6">
      <form
        method="POST"
        action="/books/{{book.id}}/update"
        class="space-y-5"
      >

        <div>
          <label for="BookTitle" class="block font-semibold mb-1">
            Book Title
          </label>
          <input
            type="text"
            id="BookTitle"
            name="BookTitle"
            value="{{book.BookTitle}}"
            required
            class="w-full border rounded-lg p-3"
          >
        </div>

        <div>
          <label for="Author" class="block font-semibold mb-1">
            Author
          </label>
          <input
            type="text"
            id="Author"
            name="Author"
            value="{{book.Author}}"
            required
            class="w-full border rounded-lg p-3"
          >
        </div>

        <div>
          <label for="Genre" class="block font-semibold mb-1">
            Genre
          </label>
          <input
            type="text"
            id="Genre"
            name="Genre"
            value="{{book.Genre}}"
            required
            class="w-full border rounded-lg p-3"
          >
        </div>

        <div>
          <label for="Quantity" class="block font-semibold mb-1">
            Quantity
          </label>
          <input
            type="number"
            id="Quantity"
            name="Quantity"
            value="{{book.Quantity}}"
            min="0"
            required
            class="w-full border rounded-lg p-3"
          >
        </div>

        <div class="flex gap-3">
          <button
            type="submit"
            class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-3 rounded-lg"
          >
            Update Book
          </button>

          <a
            href="/books"
            class="bg-gray-200 hover:bg-gray-300 px-5 py-3 rounded-lg"
          >
            Cancel
          </a>
        </div>

      </form>
    </div>
  </div>
{{> footer }}
</body>
</html>